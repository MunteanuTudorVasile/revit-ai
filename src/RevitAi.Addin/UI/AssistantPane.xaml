<Page x:Class="RevitAi.Addin.UI.AssistantPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Revit AI"
      Background="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context indicator -->
        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8" Background="#F3F4F6" CornerRadius="4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Padding="8,2" VerticalAlignment="Top"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Read the context from Revit through the dispatcher" />
                <TextBlock Text="{Binding ContextText}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Conversation -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Input -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Send" Padding="12,4" Margin="8,0,0,0"
                    Command="{Binding SendCommand}" IsDefault="True" />
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MinHeight="28"
                     VerticalContentAlignment="Center" />
        </DockPanel>
    </Grid>
</Page>
